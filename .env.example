# ==========================================
# AETHER RECON - ENVIRONMENT EXAMPLE
# ==========================================
# Copy this file to .env and fill in your values.

# --- DATABASE CONFIGURATION ---
DB_HOST=localhost
DB_NAME=aether_db
DB_USER=aether_user
DB_PASS=your_secure_password
DB_ENABLED=true

# --- APPLICATION SECRETS ---
REGISTRATION_CODE=ChangeMe_Registration_Code
CRON_SECRET=ChangeMe_Cron_Secret

# --- API KEYS ---
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
ALIENVAULT_API_KEY=
HACKERTARGET_KEY=
HUNTER_API_KEY=
GITHUB_TOKEN=
SECURITYTRAILS_KEY=
